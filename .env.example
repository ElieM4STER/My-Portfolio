# Copy this file to .env and fill in your keys
# Supabase: create a free project at https://supabase.com, then grab these from
# Project Settings > API. Run supabase/schema.sql once from the SQL editor.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI assistant (https://openrouter.ai/settings/keys)
# Preferred: the serverless function in api/chat.js reads these. They stay on the
# server, so the key is never exposed in the browser bundle.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini

# The server also reads Supabase to ground answers in your live portfolio data.
# Falls back to src/lib/fallbackData.js when these are blank.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# The browser never receives an AI key. All requests go through /api/chat, which
# reads OPENROUTER_API_KEY on the server. Do not add a VITE_ copy of this key:
# VITE_ variables are bundled into public JavaScript and are readable by visitors.

# Video messages + live calls.
# Service role key (Project Settings > API) — server only, never a VITE_ var.
# Lets api/admin.js read the private "recordings" bucket and the recordings table.
SUPABASE_SERVICE_ROLE_KEY=

# Passphrase that unlocks your private admin console at /#/admin.
# Pick something long; it is checked only on the server, never shipped to browsers.
ADMIN_PASSPHRASE=

# --- Optional platform tuning (defaults live in src/lib/settings.js) ---
# Everything below is a VITE_ var: set it in .env to override a default
# without touching any code. Restart `npm run dev` after changing.

# Kill switches
# VITE_ENABLE_CALLS=true
# VITE_ENABLE_RECORDING=true

# Live call tuning
# VITE_CALL_CHANNEL=elie-live-call
# VITE_CALL_REQUEST_TIMEOUT_MS=25000
# VITE_CALL_RING_TIMEOUT_MS=45000
# JSON array of ICE servers. Add a TURN server for strict/corporate networks:
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com","username":"user","credential":"pass"}]

# Video message tuning (upload cap must stay at or below your Supabase plan's limit)
# VITE_RECORDING_MAX_SECONDS=180
# VITE_RECORDING_MAX_MB=50